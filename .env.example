# =====================================================================
# COPIE este arquivo para ".env" e preencha. NUNCA faça commit do .env!
# No GitHub Codespaces, prefira o "Codespaces secret" (veja docs/00-configurando-a-chave.md).
# =====================================================================

# Chave individual enviada pelo professor (ou a sua própria)
OPENAI_API_KEY=

# Só preencha se a turma usar um proxy (ex.: LiteLLM). Caso contrário, deixe comentado.
# OPENAI_BASE_URL=https://proxy-da-turma.exemplo.com/v1

# Modelos do curso
MODELO_CHAT=gpt-5.4-mini
MODELO_EMBEDDINGS=text-embedding-3-small

# Raciocínio: none | low | medium | high | xhigh  (none = mais barato e rápido)
ESFORCO_RACIOCINIO=none

# Teto de tokens de saída por resposta (controla custo)
MAX_TOKENS_SAIDA=800

# Orçamento por sessão de terminal (em dólares)
LIMITE_CUSTO_SESSAO_USD=0.50

# auto = usa OpenAI se houver chave, senão modo fake | openai | fake
MODO=auto

# Observabilidade opcional (Aula 8) — plano gratuito do LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=fia-engenharia-ia
