{
  "name": "FIA - Engenharia de IA",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "hostRequirements": {
    "cpus": 2
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "pip install --user uv && ~/.local/bin/uv sync && ~/.local/bin/uv run pre-commit install",
  "postAttachCommand": "~/.local/bin/uv run python -m assistente_ia.config || true",
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "Sua chave individual da OpenAI (enviada pelo professor). Sem ela, o curso roda em modo fake, sem custo.",
      "documentationUrl": "https://github.com/sergiogaiotto/engenharia-ia-fia/blob/main/docs/00-configurando-a-chave.md"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "jupyter.notebookFileRoot": "${containerWorkspaceFolder}"
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "API do assistente" }
  }
}
